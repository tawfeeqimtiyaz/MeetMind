# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
# development | production  (development writes invite links to the log)
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
ALLOW_SIGNUP=true
JWT_EXPIRES_MINUTES=480
MAX_UPLOAD_MB=500

# --- Database (Postgres container) ---
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meetmind

# --- Email ---
# Development: Mailpit catches every email -> http://localhost:8025 (nothing reaches real inboxes).
# Real delivery: use a real SMTP service, e.g. Gmail with an App Password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_STARTTLS=true
#   SMTP_USERNAME=you@gmail.com  SMTP_PASSWORD=<16-char app password>  MAIL_FROM=MeetMind <you@gmail.com>
EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=MeetMind <no-reply@meetmind.local>

# --- Generative AI (open-source models) ---
# Used in this order, each only if configured: NVIDIA -> Groq -> local Ollama.
# NVIDIA key: https://build.nvidia.com  (model list: https://integrate.api.nvidia.com/v1/models)
NVIDIA_API_KEY=
NVIDIA_ANALYSIS_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Groq key: https://console.groq.com/keys  (also does speech-to-text with Whisper)
GROQ_API_KEY=
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Optional local fallback via Ollama on your machine (leave OLLAMA_MODEL empty to disable)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=16384

# --- Observability (optional): LangSmith traces of every LangGraph run ---
# Key: https://smith.langchain.com  -> Settings -> API Keys
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=meetmind
